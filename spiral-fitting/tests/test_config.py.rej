+def test_runtime_impact_is_an_explicit_audit_not_a_prefix_rule():
+    keys = set(Config().as_dict())
+    # Every model_/input_/pcl_ key is named by a classification table; an
+    # unnamed one would be reported as new_fit by construction, and this is
+    # where that omission becomes visible.
+    assert unaudited_prefixed_keys(keys) == []
+    assert NEW_FIT_KEYS <= keys
+    fields = Config.catalog()["schema"]["fields"]
+    for key, field in fields.items():
+        if field["runtime_impact"] == "new_fit":
+            assert field["rebuild_stage"] == (
+                "model" if key in MODEL_STAGE_KEYS else "all"), key
+        else:
+            assert "rebuild_stage" not in field, key
+
+
+def test_rebuild_stage_ignores_run_boundary_keys():
+    # A rebuild applies run-boundary changes through apply_config, so they
+    # never widen the stage a model-stage change needs.
+    assert rebuild_stage(["loss_weight_patch_radius"]) == "model"
+    assert rebuild_stage(["model_num_flow_timesteps",
+                          "pcl_sampling_weights",
+                          "model_num_flow_integration_steps",
+                          "model_flow_field_high_res_lr_scale_final"]) == (
+        "model")
+    assert rebuild_stage(["model_num_flow_timesteps",
+                          "input_use_tracks"]) == "all"
+    advertised = set(Config.catalog()["schema"]["model_stage_keys"])
+    fields = Config.catalog()["schema"]["fields"]
+    assert advertised == MODEL_STAGE_KEYS | {
+        key for key, spec in fields.items()
+        if spec["runtime_impact"] == "run_boundary"}
 
 
