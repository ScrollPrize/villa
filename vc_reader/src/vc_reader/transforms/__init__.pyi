class Plan:
    @property
    def steps(self) -> int: ...
    def apply(self, sample: Mapping[str, Any]) -> dict[str, Any]: ...

class Pipeline:
    transforms: tuple[_Config, ...]
    targets: dict[str, _Config]
    compact: bool
    @property
    def backend(self) -> str: ...
    def __init__(self, transforms: Sequence[_Config], *, targets: Mapping[str, _Config] | None = None, compact: bool = True, backend: str = "cpu") -> None: ...
    def with_targets(self, **targets: _Config) -> "Pipeline": ...
    def __call__(self, sample: Mapping[str, Any], *, seed: int, profile: bool = False, inplace: bool = False, params: Mapping[str, float] | None = None) -> dict[str, Any]: ...
    def batch(self, batch: Mapping[str, Any], *, seeds: Sequence[int], device: Any = None, params: Mapping[str, Sequence[float]] | None = None) -> dict[str, Any]: ...
    def sample(self, sample: Mapping[str, Any], *, seed: int, params: Mapping[str, float] | None = None) -> Plan: ...
    def apply(self, sample: Mapping[str, Any], plan: Plan) -> dict[str, Any]: ...

def seed(*parts: int | str) -> int: ...
def translate_crop_box(box: Sequence[int], points: Any, *, seed: int, p: float = .3, minimum: int = 10, maximum: int = 40, keep: float = ..., attempts: int = 24) -> tuple[int, ...]: ...

