@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(SQLite3 3.37)
find_dependency(Threads)
if(@VC_OBJECT_STORE_BUILD_SERVER@)
    find_dependency(Boost)
endif()
find_dependency(vc_reader CONFIG)
find_dependency(OpenSSL COMPONENTS Crypto)
find_dependency(nlohmann_json CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
if(@VC_OBJECT_STORE_BUILD_ADAPTERS@)
    find_dependency(OpenCV COMPONENTS core)
    find_dependency(TIFF)
    find_dependency(CURL)
endif()
# Only when the exported detectors link OpenMP: on macOS a build with the
# Python module may have found none, and its detectors are then serial.
if(@VC_OBJECT_STORE_DETECTORS_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vc_object_storeTargets.cmake")
