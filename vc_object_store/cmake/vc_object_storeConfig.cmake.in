@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(SQLite3)
find_dependency(Threads)
find_dependency(vc_reader CONFIG)
find_dependency(OpenSSL COMPONENTS Crypto)
find_dependency(nlohmann_json CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
if(@VC_OBJECT_STORE_BUILD_ADAPTERS@)
    find_dependency(OpenCV COMPONENTS core)
    find_dependency(TIFF)
    find_dependency(CURL)
endif()
if(@VC_OBJECT_STORE_BUILD_LINKING@)
    find_dependency(OpenMP)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vc_object_storeTargets.cmake")
