      16,
      8,
      8
    ],
    "embedding_type": "default",
    "depth": 12,
    "num_heads": 8,
    "qkv_bias": false,
    "qk_norm": true,
    "swiglu_mlp": true,
    "mlp_ratio": 2.0,
    "scale_mlp": false,
    "drop_path_rate": 0.1,
    "drop_path_uniform": false,
    "init_values": null,
    "num_reg_tokens": 4,
    "class_token": false,
