    "block_chunks": 0,
    "rope_kwargs": {
      "normalize_coords": "max"
    }
  },
  "method": {
    "name": "jem",
    "global_batch_size": 84,
    "source_chunk_size": 6,
    "categories": 512,
    "head_hidden_dim": 1024,
    "head_bottleneck_dim": 256,
    "structural_dim": 512,
    "head_nlayers": 3,
    "last_layer_type": "linear",
    "alignment_depths": [
      4,
      8,
      12
    ],
    "structural_depths": [
      0,
      4,
      8
    ],
    "depth_weights": {
      "4": 0.25,
      "8": 0.25,
      "12": 1.0
    },
    "teacher_temperature": 0.1,
    "student_temperature": 0.1,
    "entropy_rank_scope": "logical_batch",
    "global_marginal": {
      "mode": "mixed",
      "momentum": 0.9,
      "batch_weight": 0.5,
      "exact_updates": 1000
    },
    "entropy_view_scope": "crop_type",
    "structural_pair_weighting": "uniform",
    "structural_backend": "contraction",
    "momentum_teacher": 0.994,
    "regularizer_warmup_steps": 12500,
    "views": {
      "source_size": 320,
      "teacher_size": [
        128,
        224,
        224
      ],
      "global_size": [
        128,
        224,
        224
      ],
      "local_size": [
        64,
        128,
        128
      ],
      "locals_per_set": 4,
      "min_overlap_fraction": 0.1,
      "min_overlap_count": 2,
      "orientations": "z_preserving",
      "student_scale": [
        0.8,
        1.25
      ]
    },
    "masking": {
      "global": {
        "mode": "multiblock",
        "probability": 0.7,
        "fraction": 0.55
      },
      "local": {
        "mode": "random",
        "probability": 0.7,
        "fraction": 0.4
      }
    },
    "batch_storage": "host",
    "checkpoint_heads": false,
    "checkpoint_losses": false,
    "visible_weight": 0.2,
    "masked_weight": 0.8
  },
  "optimizer": {
    "lr_scaling": {
      "base_lr": 0.0003,
      "reference_batch": 64,
      "rule": "sqrt"
    },
    "lr_schedule": "constant",
