#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
villa_root=$(cd -- "${script_dir}/../.." && pwd)
python_bin=${FIBER3D_BENCH_PYTHON:-/home/hendrik/.venv_las/bin/python}
output_root=${FIBER3D_BENCH_OUTPUT:-/ephemeral/hendrik/fiber3d_train2}
reference=${FIBER3D_BENCH_REFERENCE:-${villa_root}/vesuvius/src/vesuvius/neural_tracing/fiber_trace_2d/docs/training_baseline_s1a_20260729.json}
request_file="${script_dir}/fiber3d_blur_benchmark.args"
stamp=$(date -u +%Y%m%d_%H%M%S)
output="${output_root}/blur_benchmark_${stamp}.json"

benchmark_args=()
while IFS= read -r argument || [[ -n "${argument}" ]]; do
  [[ -z "${argument}" || "${argument}" == \#* ]] && continue
  benchmark_args+=("${argument}")
done < "${request_file}"

export AGENTS_AGENT_MODE=1
export CUDA_VISIBLE_DEVICES=0
export PYTHONPATH="${villa_root}/vesuvius${PYTHONPATH:+:${PYTHONPATH}}"

exec "${python_bin}" \
  -m vesuvius.neural_tracing.fiber_trace_3d.blur_benchmark \
  --device cuda:0 \
  --reference "${reference}" \
  --output "${output}" \
  "${benchmark_args[@]}"
