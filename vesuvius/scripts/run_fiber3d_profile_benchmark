#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
villa_root=$(cd -- "${script_dir}/../.." && pwd)

python_bin=${FIBER3D_BENCH_PYTHON:-/home/hendrik/.venv_las/bin/python}
output_root=${FIBER3D_BENCH_OUTPUT:-/ephemeral/hendrik/fiber3d_train2}
reference=${FIBER3D_BENCH_REFERENCE:-${villa_root}/vesuvius/src/vesuvius/neural_tracing/fiber_trace_2d/docs/training_baseline_s1a_20260729.json}
request_file="${script_dir}/fiber3d_profile_benchmark.args"

benchmark_args=()
while IFS= read -r argument || [[ -n "${argument}" ]]; do
  [[ -z "${argument}" || "${argument}" == \#* ]] && continue
  benchmark_args+=("${argument}")
done < "${request_file}"

export AGENTS_AGENT_MODE=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONPATH="${villa_root}/gpu_manager/src:${villa_root}/vesuvius/src:${villa_root}/vesuvius:${villa_root}${PYTHONPATH:+:${PYTHONPATH}}"

for argument in "${benchmark_args[@]}"; do
  if [[ "${argument}" == "--evaluation-only" ]]; then
    exec "${python_bin}" -m vesuvius.neural_tracing.fiber_trace_3d.evaluation_benchmark \
      --reference "${reference}" --output "${output_root}" "${benchmark_args[@]}"
  fi
done

exec "${python_bin}" \
  -m vesuvius.neural_tracing.fiber_trace_3d.profile_experiment \
  --reference "${reference}" \
  --output "${output_root}" \
  "${benchmark_args[@]}"
