{
  "name": "heading_model_l0_w16_centered_frame",
  "dataset_config": "mixed_ct_datasets_paris50.json",
  "ct_normalization": "../output/heading_model_l0_w16_centered_normals/ct_normalization.json",
  "init_checkpoint": null,
  "device": "cuda",
  "steps": 70000,
  "batch": 128,
  "workers": 16,
  "worker_cache_gb": 0.5,
  "remote_prefetch_connections": 48,
  "remote_prefetch_queue_size": 512,
  "remote_prefetch_lookahead": 16,
  "remote_prefetch_timeout": 120.0,
  "lr": 0.00015,
  "weight_decay": 0.0001,
  "warmup": 0,
  "log_every": 100,
  "val_every": 2000,
  "ckpt_every": 2000,
  "val_states_per_source": 1500,
  "seed": 0,
  "model": {
    "width": 16,
    "window": 32,
    "forward": 35.5,
    "patch": {
      "depth": 32,
      "width": 32,
      "behind": 4,
      "spacing": 1.25
    },
    "predict_normals": true,
    "predict_frames": true
  },
  "sampling": {
    "seed_probability": 0.3,
    "cone_deg": 25.0,
    "cone_cap_deg": 75.0,
    "long_cone_probability": 0.1,
    "sample_config": {}
  },
  "lr_schedule": "cosine",
  "lr_decay_start": 40000,
  "normal_loss_weight": 0.25,
  "roll_loss_weight": 0.25
}
