<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>VCSettingsDlg</class>
 <widget class="QDialog" name="VCSettingsDlg">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>520</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Settings</string>
  </property>
  <layout class="QVBoxLayout" name="mainVBox">
   <item>
    <layout class="QHBoxLayout" name="columnsLayout">
     <!-- LEFT COLUMN: Volume Packages + Segment Viewer -->
     <item>
      <layout class="QVBoxLayout" name="leftColumn">
       <item>
        <widget class="QGroupBox" name="groupBox_2">
         <property name="title">
          <string>Volume Packages</string>
         </property>
         <layout class="QGridLayout" name="gridLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="label">
            <property name="text">
             <string>Default *.volpkg path</string>
            </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="edtDefaultPathVolpkg"/>
         </item>
         <item row="1" column="0" colspan="2">
          <widget class="QCheckBox" name="chkAutoOpenVolpkg">
           <property name="text">
            <string>Auto open last used *.volpkg upon app start</string>
           </property>
           <property name="checked">
            <bool>false</bool>
           </property>
          </widget>
         </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBox_3">
         <property name="title">
          <string>Segment Viewer</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_2">
          <item row="5" column="0">
           <widget class="QLabel" name="labelZoomSensitivity">
            <property name="text">
             <string>Zoom sensitivity</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QDoubleSpinBox" name="spinZoomSensitivity">
            <property name="minimum">
             <double>0.100000000000000</double>
            </property>
            <property name="maximum">
             <double>10.000000000000000</double>
            </property>
            <property name="singleStep">
             <double>0.100000000000000</double>
            </property>
            <property name="value">
             <double>1.000000000000000</double>
            </property>
           </widget>
          </item>
          <item row="8" column="0">
           <widget class="QLabel" name="label_8">
            <property name="text">
             <string>Username (for tagging)</string>
            </property>
           </widget>
          </item>
          <item row="8" column="1">
           <widget class="QLineEdit" name="edtUsername">
            <property name="placeholderText">
             <string>Enter your username</string>
            </property>
           </widget>
          </item>
          <item row="9" column="0" colspan="2">
           <widget class="QCheckBox" name="chkResetViewOnSurfaceChange">
            <property name="text">
             <string>Automatically rotate planes to align with segmentation</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
            <property name="toolTip">
             <string>When enabled, switching segments automatically rotates the slicing planes to align with the segmentation surface</string>
            </property>
           </widget>
          </item>
          <item row="11" column="0" colspan="2">
           <widget class="QCheckBox" name="chkShowPlaneIntersectionLines">
            <property name="text">
             <string>Show plane lines on segmentation view</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="toolTip">
             <string>Show slice-plane intersection lines in the segmentation surface view</string>
            </property>
           </widget>
          </item>
          <item row="12" column="0">
           <widget class="QLabel" name="labelInterpolation">
            <property name="text">
             <string>Interpolation</string>
            </property>
           </widget>
          </item>
          <item row="12" column="1">
           <widget class="QComboBox" name="cmbInterpolation">
            <item>
             <property name="text">
              <string>Nearest</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Trilinear</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="13" column="0">
           <widget class="QLabel" name="labelIntersectionOpacity">
            <property name="text">
             <string>Intersection opacity</string>
            </property>
           </widget>
          </item>
          <item row="13" column="1">
           <widget class="QSpinBox" name="spinIntersectionOpacity">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>70</number>
            </property>
            <property name="suffix">
             <string>%</string>
            </property>
            <property name="toolTip">
             <string>Adjust opacity of intersection overlays</string>
            </property>
           </widget>
          </item>
          <item row="14" column="0">
           <widget class="QLabel" name="labelAxisOverlayOpacity">
            <property name="text">
             <string>Axis overlay opacity</string>
            </property>
           </widget>
          </item>
          <item row="14" column="1">
           <widget class="QSpinBox" name="spinAxisOverlayOpacity">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>70</number>
            </property>
            <property name="suffix">
             <string>%</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="leftSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>0</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </item>
     <!-- RIGHT COLUMN: Performance + Cache -->
     <item>
      <layout class="QVBoxLayout" name="rightColumn">
       <item>
        <widget class="QGroupBox" name="groupBox_4">
         <property name="title">
          <string>Performance</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_4" columnstretch="1,1,0">
          <item row="6" column="0" colspan="2">
           <widget class="QCheckBox" name="chkEnableFileWatching">
            <property name="text">
             <string>Enable file watching (detect external changes to segments)</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
            <property name="toolTip">
             <string>When enabled, VC3D will watch for external changes to segment files and automatically reload them. Disable if you experience issues with file watching. Requires restart.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBox_5">
         <property name="title">
          <string>Cache</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_5" columnstretch="1,1,0">
          <item row="0" column="0">
           <widget class="QLabel" name="labelRamCacheSize">
            <property name="text">
             <string>RAM cache size (GB)</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="spinRamCacheSizeGB">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>512</number>
            </property>
            <property name="value">
             <number>10</number>
            </property>
            <property name="suffix">
             <string> GB</string>
            </property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QPushButton" name="btnHelpRamCacheSize">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Minimum" vsizetype="Minimum">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Total RAM budget for decoded chunks in memory.&lt;/p&gt;&lt;p&gt;Requires restart.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string/>
            </property>
            <property name="icon">
             <iconset theme="help-contents"/>
            </property>
            <property name="flat">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelRemoteCachePath">
            <property name="text">
             <string>Remote cache directory</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="edtRemoteCachePath">
            <property name="toolTip">
             <string>Changes take effect after restarting VC3D.</string>
            </property>
            <property name="placeholderText">
             <string>~/.VC3D/remote_cache</string>
            </property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QPushButton" name="btnBrowseRemoteCachePath">
            <property name="text">
             <string>Browse...</string>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="labelRemoteCacheMaximum">
            <property name="text">
             <string>Remote Zarr cache maximum (GiB)</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QSpinBox" name="spinRemoteCacheMaximumGiB">
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>1048576</number></property>
            <property name="specialValueText"><string>Unlimited</string></property>
            <property name="suffix"><string> GiB</string></property>
            <property name="toolTip"><string>Maximum managed data bytes shared by all remote volume and Lasagna Zarr caches in this cache directory. Metadata is excluded. 0 means unlimited. Applies to volumes opened afterwards.</string></property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="labelRemoteCacheMinimumFree">
            <property name="text">
             <string>Minimum free disk space (GiB)</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QSpinBox" name="spinRemoteCacheMinimumFreeGiB">
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>1048576</number></property>
            <property name="suffix"><string> GiB</string></property>
            <property name="toolTip"><string>Prevent cache growth when writing would cross this free-space reserve. 0 disables the reserve warning. Applies to volumes opened afterwards.</string></property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="lblIOThreads">
            <property name="text">
             <string>Download parallelism</string>
            </property>
            <property name="toolTip">
             <string>Use the default number of simultaneous remote downloads, or a fixed number.</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QCheckBox" name="chkAutoDownloadParallelism">
            <property name="text">
             <string>Automatic</string>
            </property>
            <property name="toolTip">
             <string>Use the default number of simultaneous downloads (16). Applies to volumes opened afterwards.</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="6" column="2">
           <widget class="QSpinBox" name="spinIOThreads">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>64</number>
            </property>
            <property name="value">
             <number>16</number>
            </property>
            <property name="toolTip">
             <string>Fixed number of simultaneous remote downloads when Automatic is disabled. Applies to volumes opened afterwards.</string>
            </property>
           </widget>
          </item>
          <item row="10" column="0">
           <widget class="QLabel" name="labelSurfaceGeometryCache">
            <property name="text">
             <string>Surface geometry cache (GB)</string>
            </property>
            <property name="toolTip">
             <string>RAM kept for surface geometry read from object stores (surface intersections and lookups), shared by all workspaces. 0 keeps none: every read decodes its surfaces again.</string>
            </property>
           </widget>
          </item>
          <item row="10" column="1">
           <widget class="QSpinBox" name="spinSurfaceGeometryCacheGB">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>512</number>
            </property>
            <property name="value">
             <number>8</number>
            </property>
            <property name="suffix">
             <string> GB</string>
            </property>
            <property name="toolTip">
             <string>RAM kept for decoded object-store surface geometry, shared by all workspaces and stores. Applies without restart.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="rightSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>0</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
