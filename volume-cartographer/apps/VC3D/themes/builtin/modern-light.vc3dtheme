{
  "vc3dTheme": 1,
  "name": "Modern Light",
  "author": "VC3D",
  "description": "Light gray panels with one teal accent, rounded controls and thin scroll bars, on Qt's Fusion style. Viewer canvases keep their colors.",
  "colorScheme": "light",
  "tokens": {
    "chrome": "#e9edf2",
    "window": "#f4f6f9",
    "section": "#eceff4",
    "section_body": "#fafbfc",
    "raised": "#ffffff",
    "header": "#f0f3f6",
    "input": "#ffffff",
    "input_disabled": "#eff1f4",
    "alt_row": "#f7f9fb",
    "button": "#ffffff",
    "button_hover": "#f0f3f7",
    "button_pressed": "#e3e8ef",
    "button_disabled": "#f1f3f6",
    "hover": "#e5eaf0",
    "scroll_handle": "#8290a1",
    "scroll_handle_hover": "#6b7685",
    "slider_track": "#d5dce5",
    "slider_handle": "#ffffff",
    "progress_track": "#ffffff",
    "progress_chunk": "#2b9bb3",
    "progress_text": "#17202b",
    "border_subtle": "#e0e5eb",
    "border": "#ccd4de",
    "field_border": "#7a8899",
    "border_strong": "#5f6b7c",
    "text": "#17202b",
    "text_secondary": "#556173",
    "text_muted": "#6a7484",
    "accent": "#0e7490",
    "accent_fill": "#0e7490",
    "accent_hover": "#155e75",
    "accent_pressed": "#164e63",
    "accent_disabled": "#a9d6e2",
    "on_accent": "#ffffff",
    "on_accent_disabled": "#3f4a58",
    "accent_soft": "#d4f1f8",
    "accent_soft_hover": "#c2eaf4",
    "accent_soft_border": "#7cc9db",
    "accent_soft_text": "#06323c",
    "item_selected": "#a8dcec",
    "focus": "#0e7490",
    "focus_soft": "#0e7490",
    "focus_on_accent": "#17202b",
    "selection": "#0e7490",
    "selection_text": "#ffffff",
    "warning_text": "#664d03",
    "warning_border": "#9a7a12",
    "danger": "#b91c1c",
    "warning": "#b45309",
    "success": "#15803d",
    "radius_small": "4px",
    "radius": "6px",
    "radius_large": "8px",
    "radius_popup": "0px",
    "font_size_small": "12px",
    "mono": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace"
  },
  "palette": {
    "BrightText": "#000000",
    "Light": "#ffffff",
    "Midlight": "#eef1f5",
    "Mid": "#a3aebc",
    "Dark": "#8a96a6",
    "Shadow": "#4b5563",
    "LinkVisited": "#6d28d9",
    "disabled": {
      "Highlight": "#d5dce5",
      "HighlightedText": "#556173",
      "PlaceholderText": "#b6bec9"
    }
  }
}
