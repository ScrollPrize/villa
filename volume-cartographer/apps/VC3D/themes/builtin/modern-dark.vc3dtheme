{
  "vc3dTheme": 1,
  "name": "Modern Dark",
  "author": "VC3D",
  "description": "Deep slate panels with one cyan accent, rounded controls and thin scroll bars, on Qt's Fusion style. Viewer canvases keep their colors.",
  "colorScheme": "dark",
  "tokens": {
    "chrome": "#11151b",
    "window": "#161b22",
    "section": "#1c232c",
    "section_body": "#191f27",
    "raised": "#1f2631",
    "header": "#1a2029",
    "input": "#0e1217",
    "input_disabled": "#141920",
    "alt_row": "#12171d",
    "button": "#212935",
    "button_hover": "#29323f",
    "button_pressed": "#313b4a",
    "button_disabled": "#1a1f27",
    "hover": "#232b36",
    "scroll_handle": "#5a687c",
    "scroll_handle_hover": "#6e7d93",
    "slider_track": "#2a3341",
    "slider_handle": "#e4e9f0",
    "progress_track": "#0e1217",
    "progress_chunk": "#0e7490",
    "progress_text": "#ffffff",
    "border_subtle": "#232b36",
    "border": "#313b49",
    "field_border": "#5b6a7f",
    "border_strong": "#718099",
    "text": "#e4e9f0",
    "text_secondary": "#9ba7b6",
    "text_muted": "#7d8a9c",
    "accent": "#22d3ee",
    "accent_fill": "#0e7490",
    "accent_hover": "#0f7d9b",
    "accent_pressed": "#0b6178",
    "accent_disabled": "#2a4e57",
    "on_accent": "#ffffff",
    "on_accent_disabled": "#b8c2ce",
    "accent_soft": "#133e4a",
    "accent_soft_hover": "#18505e",
    "accent_soft_border": "#1f6b7c",
    "accent_soft_text": "#e8fbff",
    "item_selected": "#1b5c6e",
    "focus": "#22d3ee",
    "focus_soft": "#22d3ee",
    "focus_on_accent": "#e4e9f0",
    "selection": "#0e7490",
    "selection_text": "#ffffff",
    "warning_text": "#664d03",
    "warning_border": "#9a7a12",
    "radius_small": "4px",
    "radius": "6px",
    "radius_large": "8px",
    "radius_popup": "0px",
    "mono": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace"
  },
  "palette": {
    "BrightText": "#ffffff",
    "Light": "#3a4555",
    "Midlight": "#2c3644",
    "Mid": "#4a5668",
    "Dark": "#0b0f14",
    "Shadow": "#05070a",
    "LinkVisited": "#a78bfa",
    "disabled": {
      "Highlight": "#2a3341",
      "HighlightedText": "#9ba7b6",
      "PlaceholderText": "#56627a"
    }
  }
}
