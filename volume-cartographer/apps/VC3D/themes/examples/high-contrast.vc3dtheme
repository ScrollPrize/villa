{
  "vc3dTheme": 1,
  "name": "High Contrast",
  "author": "VC3D",
  "description": "White text on black with a yellow accent and 2 px focus outlines, for low vision and bright rooms.",
  "base": "modern-dark",
  "colorScheme": "dark",
  "tokens": {
    "chrome": "#000000",
    "window": "#000000",
    "section": "#0d0d0d",
    "section_body": "#050505",
    "raised": "#0a0a0a",
    "header": "#0d0d0d",
    "input": "#000000",
    "input_disabled": "#1a1a1a",
    "alt_row": "#0d0d0d",
    "button": "#121212",
    "button_hover": "#262626",
    "button_pressed": "#333333",
    "button_disabled": "#0d0d0d",
    "hover": "#262626",
    "scroll_handle": "#c0c0c0",
    "scroll_handle_hover": "#ffffff",
    "slider_track": "#808080",
    "slider_handle": "#ffffff",
    "progress_track": "#000000",
    "progress_chunk": "#806b00",
    "progress_text": "#ffffff",
    "border_subtle": "#808080",
    "border": "#a0a0a0",
    "field_border": "#c0c0c0",
    "border_strong": "#ffffff",
    "text": "#ffffff",
    "text_secondary": "#f0f0f0",
    "text_muted": "#8f8f8f",
    "accent": "#ffd400",
    "accent_fill": "#ffd400",
    "accent_hover": "#ffe566",
    "accent_pressed": "#e6bf00",
    "accent_disabled": "#5c5200",
    "on_accent": "#000000",
    "on_accent_disabled": "#d9d9d9",
    "accent_soft": "#3d3300",
    "accent_soft_hover": "#524400",
    "accent_soft_border": "#ffd400",
    "accent_soft_text": "#ffffff",
    "item_selected": "#5c4c00",
    "focus": "#00e5ff",
    "focus_soft": "#00e5ff",
    "focus_on_accent": "#000000",
    "selection": "#ffd400",
    "selection_text": "#000000"
  },
  "palette": {
    "LinkVisited": "#ffb3ff",
    "Mid": "#a0a0a0",
    "disabled": {
      "Highlight": "#4d4d4d",
      "HighlightedText": "#d9d9d9"
    }
  },
  "qss": "QPushButton:focus, QToolButton:focus, QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus, QAbstractItemView:focus { border: 2px solid @focus@; }"
}
