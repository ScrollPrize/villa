<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Replaces the MinGW default manifest (same trustInfo and supportedOS entries)
  and adds activeCodePage UTF-8, so argv, narrow strings and std::filesystem
  conversions are UTF-8 regardless of the system code page (Windows 10 1903+;
  ignored on older systems). Without it, a path with non-ASCII characters,
  such as a user profile named with an umlaut, fails with "filesystem error:
  Cannot convert character sequence: Illegal byte sequence" (villa#1979).
  Embedded into every executable by cmake/WindowsUtf8Manifest.cmake.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista, 7, 8, 8.1, 10/11 -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
